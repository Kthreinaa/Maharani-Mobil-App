{
  "name": "maharani/mobil-app",
  "description": "Sistem Informasi Penjualan Mobil Bekas – Maharani Mobil Pekanbaru",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"if (!is_dir('app')) { mkdir('app', 0777, true); } if (!is_dir('tests')) { mkdir('tests', 0777, true); }\""
    ]
  }
}
